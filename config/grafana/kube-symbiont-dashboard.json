{
  "uid": "kube-symbiont-overview",
  "title": "kube-symbiont / ShadowWorkload overview",
  "tags": [
    "kube-symbiont"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {},
        "options": []
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kube_symbiont_shadowworkload_reserved_cpu_cores, namespace)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "current": {}
      },
      {
        "name": "name",
        "type": "query",
        "label": "ShadowWorkload",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kube_symbiont_shadowworkload_reserved_cpu_cores, name)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Measured bare-metal consumption vs scheduler reservation (CPU cores)",
      "description": "Consumption is the real measured footprint; reservation is what the phantom subtracts from allocatable.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_symbiont_shadowworkload_measured_cpu_cores{namespace=~\"$namespace\",name=~\"$name\"}",
          "legendFormat": "{{name}} measured (consumption)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_symbiont_shadowworkload_reserved_cpu_cores{namespace=~\"$namespace\",name=~\"$name\"}",
          "legendFormat": "{{name}} reserved (scheduler ledger)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Measured bare-metal consumption vs scheduler reservation (memory bytes)",
      "description": "",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_symbiont_shadowworkload_measured_memory_bytes{namespace=~\"$namespace\",name=~\"$name\"}",
          "legendFormat": "{{name}} measured (consumption)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_symbiont_shadowworkload_reserved_memory_bytes{namespace=~\"$namespace\",name=~\"$name\"}",
          "legendFormat": "{{name}} reserved (scheduler ledger)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Reservation drift minus consumption (CPU cores)",
      "description": "Persistently below zero means the workload outgrew spec.update.ceiling.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_symbiont:shadowworkload_reservation_drift_cpu_cores{namespace=~\"$namespace\",name=~\"$name\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Reservation drift minus consumption (memory bytes)",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_symbiont:shadowworkload_reservation_drift_memory_bytes{namespace=~\"$namespace\",name=~\"$name\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Measurement age (seconds since last success)",
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_symbiont:shadowworkload_measurement_age_seconds{namespace=~\"$namespace\",name=~\"$name\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Measurement failures (10m increase) and reservation updates (15m changes)",
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(kube_symbiont_shadowworkload_measurement_failures_total{namespace=~\"$namespace\",name=~\"$name\"}[10m])",
          "legendFormat": "{{name}} {{reason}} failures (10m)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "changes(kube_symbiont_shadowworkload_reservation_updates_total{namespace=~\"$namespace\",name=~\"$name\"}[15m])",
          "legendFormat": "{{name}} updates (15m changes)",
          "refId": "A"
        }
      ]
    }
  ]
}
